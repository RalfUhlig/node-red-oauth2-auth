    "oauth2",
    "security",
    "authentication",
    "authorization"
  ],
  "node-red": {
    "version": ">=3.1.0",
    "nodes": {
      "oauth2-auth": "oauth2-auth.js"
    }
  },
  "main": "oauth2-auth.js",
  "files": [
    "oauth2-auth.js",
    "oauth2-auth.html",
    "locales/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "mocha \"test/**/*_spec.js\""
